# Supply credentials locally; never commit your actual .env.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=
OPENAI_BASE_URL=

# D1: explicitly choose a vision-capable model offered by your provider.
VISION_PROVIDER=clef
VISION_MODEL=cloudflare/clef
ANTHROPIC_API_KEY=
VISION_CLICK_MODEL=claude-haiku-5-5
# Optional key override. For VISION_PROVIDER=glm these default to OPENAI_* above.
VISION_API_KEY=
VISION_BASE_URL=

# Clef route-vision and text-only Decisions smoke test.
OPENROUTER_API_KEY=

# Read-only audit: the same Claude Haiku model analyzes and reads screenshots.
AUDIT_MODEL=claude-haiku-5-5

# Jira: dry-run is the default. Store real email/token only in .env or Jenkins wbs-jira.
JIRA_SITE=https://lawxueni.atlassian.net
JIRA_PROJECT=WBSFP
JIRA_EMAIL=
JIRA_API_TOKEN=
