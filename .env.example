# Supply credentials locally; never commit your actual .env.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=
OPENAI_BASE_URL=

# D1: explicitly choose a vision-capable model offered by your provider.
VISION_PROVIDER=anthropic
VISION_MODEL=
ANTHROPIC_API_KEY=
# Optional key override. For VISION_PROVIDER=glm these default to OPENAI_* above.
VISION_API_KEY=
VISION_BASE_URL=
